<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Visitplate</AssemblyName>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
    <Version>0.1.0</Version>
    <Description>Local photo reports for site visits.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Visitplate.Core/Visitplate.Core.csproj" />
    <PackageReference Include="PDFiumCore" Version="[154.0.8035]" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="[154.0.8035]" />
  </ItemGroup>
</Project>
