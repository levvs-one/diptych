<Window x:Class="Visitplate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visitplate - фотоотчёт выезда" Width="1320" Height="880" MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}"
        PreviewKeyDown="WindowKeyDown" Closing="WindowClosing" Closed="WindowClosed">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Padding="20,12" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Margin="0,0,24,0">
                    <TextBlock Text="Visitplate" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Фотоотчёт после выезда" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
                <WrapPanel x:Name="CommandsPanel" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Новый выезд" Click="NewProjectClick" Margin="0,0,8,4" />
                    <Button Content="Открыть" Click="OpenProjectClick" Margin="0,0,8,4" />
                    <Button x:Name="SaveButton" Content="Сохранить" Click="SaveClick" Margin="0,0,8,4" />
                    <Button x:Name="ImportButton" Content="Добавить фотографии" Click="ImportClick" Margin="0,0,8,4" />
                    <Button x:Name="PrepareButton" Content="Подготовить PDF" Click="PrepareClick" Style="{StaticResource PrimaryButton}" Margin="0,0,0,4" />
                </WrapPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" x:Name="Workspace">
            <Grid x:Name="EmptyPane" Margin="40,44" VerticalAlignment="Top" MaxWidth="720" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Зафиксируйте, что изменилось." FontSize="26" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <TextBlock Text="Создайте папку выезда, добавьте фотографии и свяжите их со своими записями. Получатель сможет прочитать готовый PDF без этой программы." TextWrapping="Wrap" FontSize="16" LineHeight="24" Margin="0,0,0,28" />
                    <TextBlock Text="Оригиналы сохраняются в рабочей папке. Приложение не отправляет фотографии в интернет." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
            </Grid>
            <Grid x:Name="EditorPane" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="156" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="208" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Grid.RowSpan="2" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,1,0" Padding="12,20">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Узлы выезда" Style="{StaticResource SectionLabel}" />
                            <Button Content="Добавить узел" Click="AddObservationClick" Margin="0,0,0,12" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <Button Content="Выше" Click="MoveObservationUpClick" Margin="0,0,4,0" />
                                <Button Content="Ниже" Click="MoveObservationDownClick" Margin="4,0,0,0" />
                            </UniformGrid>
                            <Button Content="Убрать из отчёта" Click="RemoveObservationClick" />
                            <TextBlock Text="Оригиналы останутся в проекте." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                        <ListBox x:Name="ObservationsList" SelectionChanged="ObservationSelectionChanged" AutomationProperties.Name="Узлы отчёта"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding NumberLabel}" FontSize="12" />
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2,0,4" />
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,20,28,32">
                        <Expander x:Name="DetailsExpander" Header="Данные выезда" IsExpanded="True" Margin="0,0,0,24">
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Название отчёта" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="TitleBox" AutomationProperties.Name="Название отчёта" LostKeyboardFocus="EditorLostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="Объект или место" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="SiteBox" AutomationProperties.Name="Объект выезда" LostKeyboardFocus="EditorLostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                    <TextBlock Text="Исполнитель" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="AuthorBox" AutomationProperties.Name="Исполнитель" LostKeyboardFocus="EditorLostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="Дата выезда - указана вами" Style="{StaticResource FieldLabel}" />
                                    <DatePicker x:Name="DateBox" AutomationProperties.Name="Дата выезда" SelectedDateChanged="DateChanged" DateValidationError="DateValidationError" />
                                </StackPanel>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="Заказчик - необязательно" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CustomerBox" AutomationProperties.Name="Заказчик" LostKeyboardFocus="EditorLostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="Номер заявки - необязательно" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ReferenceBox" AutomationProperties.Name="Номер заявки" LostKeyboardFocus="EditorLostFocus" />
                                </StackPanel>
                            </Grid>
                        </Expander>
                        <TextBlock x:Name="NoObservationText" Text="Добавьте узел слева: прибор, помещение или отдельный результат работы." TextWrapping="Wrap" FontSize="18" Margin="0,12" />
                        <StackPanel x:Name="ObservationEditor" Visibility="Collapsed">
                            <TextBlock Text="Название узла" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ObservationTitleBox" FontSize="18" FontWeight="SemiBold" AutomationProperties.Name="Название узла" LostKeyboardFocus="EditorLostFocus" Margin="0,0,0,16" />
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ДО" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Border Background="{DynamicResource PaperBrush}" MinHeight="180" Padding="8">
                                        <Grid><Image x:Name="BeforeImage" Height="228" Stretch="Uniform" AutomationProperties.Name="Снимок до" />
                                            <TextBlock x:Name="BeforeEmpty" Text="Снимок до не добавлен" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" /></Grid>
                                    </Border>
                                    <TextBlock x:Name="BeforeCaption" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ПОСЛЕ" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Border Background="{DynamicResource PaperBrush}" MinHeight="180" Padding="8">
                                        <Grid><Image x:Name="AfterImage" Height="228" Stretch="Uniform" AutomationProperties.Name="Снимок после" />
                                            <TextBlock x:Name="AfterEmpty" Text="Снимок после не добавлен" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" /></Grid>
                                    </Border>
                                    <TextBlock x:Name="AfterCaption" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                            <StackPanel MaxWidth="680" HorizontalAlignment="Stretch">
                                <TextBlock Text="Наблюдение" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="FindingBox" Style="{StaticResource NoteBox}" AutomationProperties.Name="Наблюдение" LostKeyboardFocus="EditorLostFocus" Margin="0,0,0,16" />
                                <TextBlock Text="Выполнено" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="WorkDoneBox" Style="{StaticResource NoteBox}" AutomationProperties.Name="Выполненная работа" LostKeyboardFocus="EditorLostFocus" Margin="0,0,0,16" />
                                <TextBlock Text="Осталось" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RemainingBox" Style="{StaticResource NoteBox}" AutomationProperties.Name="Оставшиеся действия" LostKeyboardFocus="EditorLostFocus" Margin="0,0,0,16" />
                                <TextBlock Text="Статус, указанный вами" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="StatusBox" SelectionChanged="StatusChanged" AutomationProperties.Name="Статус узла" DisplayMemberPath="Value" SelectedValuePath="Key" Margin="0,0,0,24" />
                            </StackPanel>
                            <TextBlock Text="Снимки этого узла" Style="{StaticResource SectionLabel}" />
                            <ListBox x:Name="UsesList" SelectionChanged="PhotoUseSelectionChanged" MaxHeight="180" AutomationProperties.Name="Снимки выбранного узла" DisplayMemberPath="Label" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Подпись выбранного снимка - до 400 символов" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CaptionBox" AutomationProperties.Name="Подпись снимка" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" LostKeyboardFocus="CaptionLostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Bottom">
                                    <Button Content="Повернуть на 90°" Click="RotatePhotoClick" Margin="0,0,0,8" />
                                    <Button Content="Убрать снимок из узла" Click="RemovePhotoUseClick" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Снимок выше" Click="MovePhotoUseUpClick" Margin="0,0,8,0" />
                                <Button Content="Снимок ниже" Click="MovePhotoUseDownClick" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0" Padding="12,8" Background="{DynamicResource PaperBrush}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Width="180" Margin="12,0,0,0">
                            <TextBlock x:Name="AssetSummary" Text="Фотографии проекта" FontSize="12" Margin="0,0,0,6" />
                            <WrapPanel><Button Content="Назначить ДО" Click="AssignBeforeClick" Margin="0,0,0,4" /><Button Content="Назначить ПОСЛЕ" Click="AssignAfterClick" Margin="0,0,0,4" /><Button Content="Общий вид" Click="AssignOverviewClick" /></WrapPanel>
                        </StackPanel>
                        <ListBox x:Name="AssetsList" AutomationProperties.Name="Фотографии проекта" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate><DataTemplate>
                                <StackPanel Width="126">
                                    <Image Width="126" Height="82" Stretch="Uniform" Loaded="ThumbnailLoaded" Unloaded="ThumbnailUnloaded" />
                                    <TextBlock Text="{Binding OriginalFileName}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalFileName}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
            <Grid x:Name="PreviewPane" Visibility="Collapsed" Margin="20,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <Button Content="Вернуться к редактированию" Click="BackToEditorClick" DockPanel.Dock="Left" />
                    <TextBlock x:Name="DraftInfoText" Margin="20,0" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer x:Name="PdfScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Image x:Name="PdfImage" Stretch="Uniform" VerticalAlignment="Top" AutomationProperties.Name="Страница подготовленного PDF" />
                </ScrollViewer>
                <DockPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button x:Name="PublishButton" Content="Сохранить этот PDF" Style="{StaticResource PrimaryButton}" Click="PublishClick" DockPanel.Dock="Right" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PreviousPageButton" Content="Назад" Click="PreviousPageClick" Margin="0,0,8,0" />
                        <TextBlock x:Name="PageLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button x:Name="NextPageButton" Content="Далее" Click="NextPageClick" Margin="0,0,16,0" />
                        <ComboBox x:Name="ZoomBox" Width="156" SelectedIndex="0" SelectionChanged="ZoomChanged" AutomationProperties.Name="Масштаб страницы"><ComboBoxItem Content="Страница целиком" /><ComboBoxItem Content="По ширине" /></ComboBox>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource PaperBrush}" Padding="20,10">
            <DockPanel>
                <Button x:Name="CancelButton" Content="Отменить операцию" Click="CancelClick" DockPanel.Dock="Right" Margin="16,0,0,0" Visibility="Collapsed" />
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="Создайте новый выезд или откройте папку проекта." TextWrapping="Wrap" />
                    <TextBlock x:Name="SaveStateText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Заказчику передавайте PDF. Рабочая папка содержит оригиналы и их метаданные." FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
